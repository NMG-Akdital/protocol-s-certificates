# ---- required in production ----
APP_ENV=production
# The public address printed inside every QR code. Choose it once and keep it forever.
PUBLIC_BASE_URL=https://verify.yourdomain.com
# Used by Caddy for HTTPS (the host part of PUBLIC_BASE_URL)
DOMAIN=verify.yourdomain.com
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
# Signs certificate records. NEVER change it after issuing certificates, or every record will fail its integrity check.
CERT_SIGNING_KEY=change-me-to-a-different-long-random-value

# ---- optional ----
# DATABASE_URL=sqlite:////data/protocol_s.db          (default)
# DATABASE_URL=postgresql://user:password@host:5432/protocol_s
# CERT_PREFIX=PS
# VERIFY_RATE_LIMIT_PER_MINUTE=30
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# SESSION_MAX_AGE_SECONDS=28800
# MAX_UPLOAD_MB=5
# MAX_IMPORT_ROWS=2000
